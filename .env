                            <div class="flow-title">Resfriamento do Leite</div>
                        </div>
                        <div class="flowchart-node-item" onclick="activateFlowStep(5)">
                            <div class="flow-num">5</div>
                            <div class="flow-title">Inoculação de Culturas</div>
                        </div>
                        <div class="flowchart-node-item" onclick="activateFlowStep(6)">
                            <div class="flow-num">6</div>
                            <div class="flow-title">Fermentação Controlada</div>
                        </div>
                        <div class="flowchart-node-item" onclick="activateFlowStep(7)">
                            <div class="flow-num">7</div>
                            <div class="flow-title">Adição de Ingredientes</div>
                        </div>
                        <div class="flowchart-node-item" onclick="activateFlowStep(8)">
                            <div class="flow-num">8</div>
                            <div class="flow-title">Homogeneização</div>
                        </div>
                        <div class="flowchart-node-item" onclick="activateFlowStep(9)">
                            <div class="flow-num">9</div>
